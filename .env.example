# OpenClass Platform — Environment Configuration
# Copy this to .env and fill in your real values.
# Never commit .env to git!

# ===== App Mode =====
APP_MODE=production

# ===== Security (CHANGE THESE!) =====
APP_SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_SECRET_KEY=change-me-openclass-jwt-secret-key-min-32-chars

# ===== Database =====
DATABASE_PATH=data/classroomflow.db

# ===== Google OAuth (for Google Meet + Gmail) =====
# Get from: https://console.cloud.google.com/ → Credentials → OAuth 2.0 Client IDs
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://YOUR-RAILWAY-DOMAIN.railway.app/auth/google/callback

# ===== Microsoft Entra ID / Azure AD (for Real MS SSO) =====
# Get from: https://portal.azure.com/ → Azure Active Directory → App Registrations
# Step 1: Register a new app at https://portal.azure.com
# Step 2: Under "Authentication", add redirect URI: https://YOUR-DOMAIN/auth/microsoft/callback
# Step 3: Under "Certificates & secrets", create a Client Secret
# Step 4: Note your Application (client) ID and Directory (tenant) ID
MS_CLIENT_ID=your-azure-app-client-id
MS_CLIENT_SECRET=your-azure-app-client-secret
MS_TENANT_ID=your-azure-tenant-id
# Use "common" for multi-tenant (any Microsoft account)
# Use your actual tenant ID for single-organization (e.g., IMDR)
MS_REDIRECT_URI=https://YOUR-RAILWAY-DOMAIN.railway.app/auth/microsoft/callback

# ===== Email Notifications =====
EMAIL_DELIVERY_ALLOWED=true
EMAIL_DELIVERY_ENABLED=true
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
# Use Gmail App Password (not your main password)
# https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-gmail-app-password
SENDER_EMAIL=openclass@your-institution.edu

# ===== Twilio SMS (optional) =====
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# ===== Simulation Mode =====
# Set false in production to enable real email/SMS delivery
SIMULATION_MODE=false

# ===== Allowed Domain =====
ALLOWED_EMAIL_DOMAIN=imdr.edu
